# Optional. When set, the notification flow creates a real Web Push
# subscription (VAPID). Generate a key pair with:  npx web-push generate-vapid-keys
# Leave unset for local-only reminders (the default for this prototype).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Photon Neutron sandbox. Secrets are read only by api/ and the local MCP server.
PHOTON_CLIENT_ID=
PHOTON_CLIENT_SECRET=
# Optional override of the screening allow-list, by design. Left empty,
# screening allows only the demo catalog in
# src/lib/clinician/photonTreatments.json, which is already a closed in-repo
# list, so the gate still fails closed for anything outside it. Set it to a
# comma separated list of treatment ids to replace that list. Either way an id
# outside the effective set is refused server-side before any sandbox call.
PHOTON_ALLOWED_TREATMENT_IDS=
PHOTON_AUTH_URL=https://auth.neutron.health/oauth/token
PHOTON_AUDIENCE=https://api.neutron.health
PHOTON_GRAPHQL_URL=https://clinical-api.neutron.health/graphql
PHOTON_MAIN_GRAPHQL_URL=https://api.neutron.health/graphql
# User access token for the clinical API, used ONLY by the read-only
# prescriptionScreen call. prescriptionScreen resolves a user and the machine to
# machine client has none, so live screening needs this (app.neutron.health,
# Settings, Developers). Never used for a mutation. Server side only: never
# prefix it with NEXT_PUBLIC_ and never commit it. These tokens expire, so it
# must be set in the Vercel environment variables at ship time and refreshed
# when it lapses. Without it, screening falls back to the recorded sandbox
# responses in fixtures/photon/ and the UI says so.
PHOTON_USER_TOKEN=

# Grounded clinician explanation model. The deterministic local answer remains
# available when this is unset; the UI labels which path answered.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=http://localhost:3333
