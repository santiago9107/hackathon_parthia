# Optional. When set, the notification flow creates a real Web Push
# subscription (VAPID). Generate a key pair with:  npx web-push generate-vapid-keys
# Leave unset for local-only reminders (the default for this prototype).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-side only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-astra

# Optional additional production/preview origins, comma-separated.
MEAL_AI_ALLOWED_ORIGINS=
