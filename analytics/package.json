{
  "name": "@parthia/analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Holistic analysis module for Parthia Health: deterministic, pure, no LLM calls.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
