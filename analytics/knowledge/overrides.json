    "R15": { "not_evaluable": true, "reason": "Threshold undefined: 'rise vs baseline (define % with clinician)'.", "decision": "DEC-08" },
    "R16": { "decision": "DEC-08", "combine_decision": "DEC-15", "systolic_gte": 140, "diastolic_gte": 90, "combine": "or", "min_high_readings": 3, "min_readings": 4, "window_days": 7, "threshold_id": "T06" },
