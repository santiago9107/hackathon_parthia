    "R12": { "element": "D008", "analyte": "sodium", "threshold_id": "T02", "op": "<", "value": 130, "unit": "mEq/L" },
    "R13": { "element": "D009", "analyte": "egfr", "threshold_id": "T03", "drop_fraction_gte": 0.30, "baseline": "care_plan", "kb_text": "Baseline set by clinician" },
