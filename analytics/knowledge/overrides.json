{
  "$comment": "Structured clinical parameters that the Excel text cannot express unambiguously. Every value here traces to a decision in DECISIONS.md (DEC-xx) or to verbatim KB text (kb_text). Values marked review_status=draft_verify are engineering drafts the clinical lead must verify. Do not edit without updating DECISIONS.md.",
  "overrides_version": "2026-10-03.2",
  "decisions": [
    { "id": "DEC-01", "topic": "R02/R03 phenotype scope", "decision": "R02 and R03 apply to all HF phenotypes when an MRA is active. TC02 (HFpEF) is correct.", "affects": ["R02", "R03", "TC02"] },
    { "id": "DEC-02", "topic": "HF phenotype (D003)", "decision": "2022 AHA/ACC/HFSA: LVEF <=40 HFrEF; 41-49 HFmrEF; >=50 HFpEF; prior <=40 and now >40 HFimpEF. R04: HFrEF/HFimpEF High, HFmrEF Moderate, HFpEF not flagged.", "affects": ["D002", "D003", "R04", "TC05"] },
    { "id": "DEC-03", "topic": "Validity after MRA/RAAS start or dose change", "decision": "For D007 and D009, results drawn before the latest MRA/ACEi/ARB/ARNI start or dose change no longer count. A post-change result is expected within 14 days; without one the element is missing.", "affects": ["D007", "D009"] },
    { "id": "DEC-04", "topic": "Weight gain (R08, T05)", "decision": "1-day gain >= 0.9 kg; 7-day gain >= 2.3 kg measured from the lowest value in the previous 7 days; both inclusive. Care-plan limits override.", "affects": ["R08", "T05", "TC04"] },
    { "id": "DEC-05", "topic": "R07 escalation", "decision": "R07 escalates to High when an MRA is active AND (potassium >= 5.0, or potassium rose >= 0.5 mEq/L versus the previous result within 90 days).", "affects": ["R07", "TC03"] },
    { "id": "DEC-06", "topic": "Urgent labs", "decision": "Potassium >= 6.0 or < 3.0, sodium < 125, INR > 4.5 go to urgent[]. eGFR drop >= 30% stays High (R13), not urgent.", "affects": ["T01", "T02", "T03", "T11", "R13"] },
    { "id": "DEC-07", "topic": "R21 'with symptoms'", "decision": "SBP < 80 or HR < 40 / > 120 is urgent with dizziness, fainting, chest pain, severe breathlessness or confusion reported within 24 h of the reading. Fainting, chest pain, severe breathlessness at rest and confusion are urgent on their own.", "affects": ["R21", "T06", "T07", "T09"] },
    { "id": "DEC-08", "topic": "Undefined thresholds", "decision": "R09: 2 low readings within 7 days. R16: >= 3 readings at >= 140/90 among the last 7 days, minimum 4 readings. R20: >= 2 missed doses of any HF medicine in 7 days. R15: not evaluable, threshold undefined.", "affects": ["R09", "R15", "R16", "R20"] },
    { "id": "DEC-09", "topic": "R02 clinician note wording", "decision": "Replace R02 clinician note to avoid directive wording. Forbidden-phrase scan stays strict on all generated text.", "affects": ["R02"] },
    { "id": "DEC-10", "topic": "Risk score tables", "decision": "Build structure and input checks only. ACB, Charlson, LACE and MAGGIC tables to be supplied by the clinical lead.", "affects": [] },
    { "id": "DEC-11", "topic": "Unit conversions", "decision": "lb -> kg x 0.45359237; potassium and sodium mmol/L = mEq/L; creatinine umol/L / 88.4 -> mg/dL.", "affects": ["D007", "D008", "D009", "D011"] },
    { "id": "DEC-12", "topic": "Domain mapping", "decision": "KB 1, 4, 6, 7 -> Medication safety; 2 -> Heart-kidney labs; 3 -> Fluid/congestion; 5 -> BP/HR; 8 -> Nutrition; 9 -> Mental health (R19) / Adherence (R20); 10 -> urgent[].", "affects": [] },
    { "id": "DEC-13", "topic": "Care-plan targets", "decision": "Care-plan targets are tagged with the element they override and source 'care plan'.", "affects": ["D011", "D012", "D009", "D010", "D019"] },
    { "id": "DEC-14", "topic": "Priority defaults", "decision": "Modifiability and evidence strength default to 0.5 until the clinical panel sets values.", "affects": [] },
    { "id": "DEC-15", "topic": "BP 'x/y' thresholds use OR", "decision": "Urgent BP: systolic >= 180 OR diastolic >= 120. R16: a reading counts as high when systolic >= 140 OR diastolic >= 90. R16 switched on.", "affects": ["R16", "R21", "T06"] },
    { "id": "DEC-16", "topic": "Urgent message wording", "decision": "R21 and R22 patient messages approved as written in config/messages.json.", "affects": ["R21", "R22"] },
    { "id": "DEC-17", "topic": "Urgent pathway in every mode", "decision": "R21, R22 and urgent labs run in every knowledge mode, even while Draft, and are marked 'Draft – pending clinical approval' in the output.", "affects": ["R21", "R22", "T01", "T02", "T06", "T07", "T08", "T09", "T11"] },
    { "id": "DEC-18", "topic": "Unconfirmed red flags", "decision": "Patient-entered data (symptoms, PHQ-9, logs) counts as confirmed on entry; confirmation applies to imported data. Any unconfirmed, pending or conflicting item that would be urgent triggers the urgent message AND is listed in needs_review.", "affects": ["R21", "R22", "D014", "D016"] }
  ],

