{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parthia/knowledge/domain_tracker.schema.json",
  "title": "Parthia HF knowledge base: domain_tracker",
  "type": "object",
  "required": [
    "knowledge_version",
    "source_workbook",
    "sheet",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "source_workbook": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kb_domain": {
            "type": "string",
            "pattern": "^\\d+\\. "
          },
          "key_question": {},
          "week": {},
          "source_ids_text": {},
          "target_rules": {},
          "rules_approved": {},
          "target_cards": {},
          "cards_approved": {},
          "target_tests": {},
          "tests_ready": {},
          "status": {},
          "notes": {},
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kb_domain",
          "key_question",
          "week",
          "source_ids_text",
          "target_rules",
          "rules_approved",
          "target_cards",
          "cards_approved",
          "target_tests",
          "tests_ready",
          "status",
          "notes",
          "source_ids"
        ],
        "additionalProperties": false
      }
    }
  }
}
