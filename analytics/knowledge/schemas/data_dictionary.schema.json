{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parthia/knowledge/data_dictionary.schema.json",
  "title": "Parthia HF knowledge base: data_dictionary",
  "type": "object",
  "required": [
    "knowledge_version",
    "source_workbook",
    "sheet",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "source_workbook": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^D\\d{3}$"
          },
          "name": {},
          "category": {},
          "definition": {},
          "data_type": {},
          "unit": {},
          "code_system": {},
          "code": {},
          "data_source": {},
          "frequency": {},
          "valid_for_analysis": {},
          "priority": {},
          "required_by_rules": {},
          "used_by_agent": {},
          "source_ids_text": {},
          "review_status_text": {},
          "notes": {},
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "enum": [
              "draft_verify",
              "in_review",
              "approved",
              "retired"
            ]
          },
          "required_by_rule_ids": {},
          "validity": {},
          "validity_has_context": {},
          "mvp": {}
        },
        "required": [
          "element_id",
          "name",
          "category",
          "definition",
          "data_type",
          "unit",
          "code_system",
          "code",
          "data_source",
          "frequency",
          "valid_for_analysis",
          "priority",
          "required_by_rules",
          "used_by_agent",
          "source_ids_text",
          "review_status_text",
          "notes",
          "source_ids",
          "review_status",
          "required_by_rule_ids",
          "validity",
          "validity_has_context",
          "mvp"
        ],
        "additionalProperties": false
      }
    }
  }
}
