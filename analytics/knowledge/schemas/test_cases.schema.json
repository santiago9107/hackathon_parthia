{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parthia/knowledge/test_cases.schema.json",
  "title": "Parthia HF knowledge base: test_cases",
  "type": "object",
  "required": [
    "knowledge_version",
    "source_workbook",
    "sheet",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "source_workbook": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string",
            "pattern": "^TC\\d{2}$"
          },
          "kb_domain": {},
          "scenario": {},
          "input_data": {},
          "expected_rules_text": {},
          "expected_severity_text": {},
          "expected_output": {},
          "must_not_say": {},
          "source_ids_text": {},
          "status": {},
          "last_result": {},
          "notes": {},
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_rule_ids": {},
          "expected_severity": {}
        },
        "required": [
          "test_id",
          "kb_domain",
          "scenario",
          "input_data",
          "expected_rules_text",
          "expected_severity_text",
          "expected_output",
          "must_not_say",
          "source_ids_text",
          "status",
          "last_result",
          "notes",
          "source_ids",
          "expected_rule_ids",
          "expected_severity"
        ],
        "additionalProperties": false
      }
    }
  }
}
