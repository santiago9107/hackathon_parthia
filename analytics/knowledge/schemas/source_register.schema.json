{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parthia/knowledge/source_register.schema.json",
  "title": "Parthia HF knowledge base: source_register",
  "type": "object",
  "required": [
    "knowledge_version",
    "source_workbook",
    "sheet",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "source_workbook": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^S\\d{2}$"
          },
          "title": {},
          "organization": {},
          "version": {},
          "source_type": {},
          "scope": {},
          "audience": {},
          "link": {},
          "license_status": {},
          "full_text_storable": {},
          "source_status": {},
          "date_accessed": {},
          "notes": {}
        },
        "required": [
          "source_id",
          "title",
          "organization",
          "version",
          "source_type",
          "scope",
          "audience",
          "link",
          "license_status",
          "full_text_storable",
          "source_status",
          "date_accessed",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  }
}
