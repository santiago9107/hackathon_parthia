{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parthia/knowledge/rules.schema.json",
  "title": "Parthia HF knowledge base: rules",
  "type": "object",
  "required": [
    "knowledge_version",
    "source_workbook",
    "sheet",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "source_workbook": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^R\\d{2}$"
          },
          "name": {},
          "category": {},
          "drugs": {},
          "data_needed": {},
          "condition": {},
          "threshold_values": {},
          "severity_text": {},
          "patient_question": {
            "type": "string"
          },
          "clinician_note": {},
          "source_ids_text": {},
          "section": {},
          "agent": {},
          "phenotype": {},
          "data_sources": {},
          "comments": {},
          "review_status_text": {},
          "reviewed_by": {},
          "date_reviewed": {},
          "kb_domain": {},
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "enum": [
              "draft_verify",
              "in_review",
              "approved",
              "retired"
            ]
          },
          "severity": {
            "enum": [
              "urgent",
              "high",
              "moderate",
              "low"
            ]
          },
          "element_ids": {},
          "threshold_ids": {}
        },
        "required": [
          "rule_id",
          "name",
          "category",
          "drugs",
          "data_needed",
          "condition",
          "threshold_values",
          "severity_text",
          "patient_question",
          "clinician_note",
          "source_ids_text",
          "section",
          "agent",
          "phenotype",
          "data_sources",
          "comments",
          "review_status_text",
          "reviewed_by",
          "date_reviewed",
          "kb_domain",
          "source_ids",
          "review_status",
          "severity",
          "element_ids",
          "threshold_ids"
        ],
        "additionalProperties": false
      }
    }
  }
}
