{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parthia/knowledge/thresholds.schema.json",
  "title": "Parthia HF knowledge base: thresholds",
  "type": "object",
  "required": [
    "knowledge_version",
    "source_workbook",
    "sheet",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "source_workbook": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "threshold_id": {
            "type": "string",
            "pattern": "^T\\d{2}$"
          },
          "element_id": {
            "type": "string",
            "pattern": "^D\\d{3}$"
          },
          "measure": {},
          "unit": {},
          "reference_range": {},
          "hf_target": {},
          "alert_low": {},
          "alert_high": {},
          "urgent": {},
          "context": {},
          "patient_override": {},
          "source_ids_text": {},
          "review_status_text": {},
          "notes": {},
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "enum": [
              "draft_verify",
              "in_review",
              "approved",
              "retired",
              null
            ]
          },
          "alert_low_parsed": {},
          "alert_high_parsed": {},
          "urgent_parsed": {}
        },
        "required": [
          "threshold_id",
          "element_id",
          "measure",
          "unit",
          "reference_range",
          "hf_target",
          "alert_low",
          "alert_high",
          "urgent",
          "context",
          "patient_override",
          "source_ids_text",
          "review_status_text",
          "notes",
          "source_ids",
          "review_status",
          "alert_low_parsed",
          "alert_high_parsed",
          "urgent_parsed"
        ],
        "additionalProperties": false
      }
    }
  }
}
