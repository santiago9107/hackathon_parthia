{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parthia/knowledge/recommendation_cards.schema.json",
  "title": "Parthia HF knowledge base: recommendation_cards",
  "type": "object",
  "required": [
    "knowledge_version",
    "source_workbook",
    "sheet",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "knowledge_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "source_workbook": {
      "type": "string"
    },
    "sheet": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string",
            "pattern": "^C\\d{2}$"
          },
          "topic": {},
          "recommendation": {},
          "class_of_recommendation": {},
          "level_of_evidence": {},
          "population": {},
          "drug_tags": {},
          "data_tags": {},
          "used_by_agent": {},
          "patient_text": {},
          "source_ids_text": {},
          "section": {},
          "review_status_text": {},
          "reviewed_by": {},
          "date_reviewed": {},
          "related_rules_text": {},
          "kb_domain": {},
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "enum": [
              "draft_verify",
              "in_review",
              "approved",
              "retired",
              null
            ]
          },
          "related_rule_ids": {}
        },
        "required": [
          "card_id",
          "topic",
          "recommendation",
          "class_of_recommendation",
          "level_of_evidence",
          "population",
          "drug_tags",
          "data_tags",
          "used_by_agent",
          "patient_text",
          "source_ids_text",
          "section",
          "review_status_text",
          "reviewed_by",
          "date_reviewed",
          "related_rules_text",
          "kb_domain",
          "source_ids",
          "review_status",
          "related_rule_ids"
        ],
        "additionalProperties": false
      }
    }
  }
}
